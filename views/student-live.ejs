<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Live Class • <%= tutor.name %></title>
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap');
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: radial-gradient(circle at 20% 30%, #0a0f1e, #03050b);
      min-height: 100vh;
    }
    .glass-panel {
      background: rgba(12, 20, 30, 0.55);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(66, 153, 225, 0.25);
    }
    .live-pulse {
      animation: gentlePulse 1.5s infinite;
    }
    @keyframes gentlePulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.7; transform: scale(1.05); }
    }
    .video-container {
      background: #000;
      border-radius: 1.5rem;
      overflow: hidden;
      box-shadow: 0 25px 40px -12px rgba(0,0,0,0.6);
      transition: all 0.2s;
    }
    .mirror-video {
      transform: scaleX(-1);
      -webkit-transform: scaleX(-1);
    }
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: #1e293b; border-radius: 10px; }
    ::-webkit-scrollbar-thumb { background: #3b82f6; border-radius: 10px; }
    .control-btn {
      transition: all 0.2s ease;
      backdrop-filter: blur(8px);
    }
    .control-btn:hover {
      transform: scale(1.05);
      background: rgba(59,130,246,0.9);
    }
  </style>
</head>
<body class="text-white">

  <div class="fixed top-0 left-0 right-0 z-20 bg-black/40 backdrop-blur-md border-b border-white/10">
    <div class="container mx-auto px-5 py-3 flex justify-between items-center flex-wrap gap-3">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-blue-500 to-purple-500 flex items-center justify-center shadow-lg">
          <i class="fas fa-chalkboard-user text-white text-sm"></i>
        </div>
        <div>
          <h1 class="font-bold text-base md:text-lg tracking-tight"><%= tutor.name %>'s Studio</h1>
          <p class="text-[11px] text-gray-300 flex items-center gap-1"><span class="w-1.5 h-1.5 bg-red-500 rounded-full animate-pulse"></span> LIVE CLASS</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <div class="bg-black/50 backdrop-blur px-3 py-1.5 rounded-full text-xs flex items-center gap-2">
          <i class="fas fa-eye text-sky-400 text-xs"></i>
          <span id="viewerCountDisplay" class="font-mono font-bold">0</span>
          <span class="text-gray-300">watching</span>
        </div>
        <button onclick="window.close()" class="bg-red-600/80 hover:bg-red-600 text-white px-4 py-1.5 rounded-full text-sm flex items-center gap-2 transition-all shadow-md">
          <i class="fas fa-sign-out-alt"></i> <span class="hidden sm:inline">Leave</span>
        </button>
      </div>
    </div>
  </div>

  <main class="container mx-auto px-4 pt-20 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-4">
        <div class="video-container relative group">
          <video id="studentVideo" autoplay playsinline class="w-full h-auto max-h-[70vh] object-contain mirror-video"></video>
          
          <div class="absolute top-4 left-4 flex gap-2 opacity-80 group-hover:opacity-100 transition">
            <div class="glass-panel rounded-full px-3 py-1 text-xs flex items-center gap-1.5">
              <i class="fas fa-video text-blue-300 text-xs"></i>
              <span id="videoStatusBadge">Connecting</span>
            </div>
            <div class="glass-panel rounded-full px-3 py-1 text-xs flex items-center gap-1.5">
              <i class="fas fa-microphone-alt text-green-300 text-xs"></i>
              <span id="audioStatusBadge">Waiting</span>
            </div>
          </div>
          
          <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-3 opacity-0 group-hover:opacity-100 transition-all duration-200 bg-black/60 backdrop-blur-lg rounded-full px-4 py-2">
            <button id="floatingMuteBtn" class="control-btn bg-white/10 hover:bg-blue-600 text-white rounded-full w-8 h-8 flex items-center justify-center">
              <i class="fas fa-microphone-slash text-sm"></i>
            </button>
            <button id="floatingVolumeUp" class="control-btn bg-white/10 hover:bg-blue-600 rounded-full w-8 h-8 flex items-center justify-center">
              <i class="fas fa-volume-up text-sm"></i>
            </button>
            <button id="floatingVolumeDown" class="control-btn bg-white/10 hover:bg-blue-600 rounded-full w-8 h-8 flex items-center justify-center">
              <i class="fas fa-volume-down text-sm"></i>
            </button>
          </div>
        </div>

        <div class="glass-panel rounded-2xl p-4 grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
          <div class="flex flex-col"><span class="text-gray-400">Stream status</span><span id="streamStatusText" class="font-mono text-cyan-300 font-semibold">Connecting...</span></div>
          <div class="flex flex-col"><span class="text-gray-400">ICE state</span><span id="iceStateText" class="font-mono">-</span></div>
          <div class="flex flex-col"><span class="text-gray-400">Signaling</span><span id="signalingStateText" class="font-mono">-</span></div>
          <div class="flex flex-col"><span class="text-gray-400">Quality</span><span id="qualityHint" class="text-green-300">HD</span></div>
        </div>
      </div>

      <div class="space-y-5">
        <div class="glass-panel rounded-2xl p-5">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-8 h-8 rounded-full bg-emerald-500/20 flex items-center justify-center"><i class="fas fa-headphones text-emerald-400 text-sm"></i></div>
            <h3 class="font-bold">Audio Studio</h3>
          </div>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2"><i class="fas fa-microphone-alt text-gray-400"></i><span class="text-xs">Microphone output</span></div>
              <button id="studentMuteBtn" class="bg-gray-700 hover:bg-blue-600 text-white px-3 py-1.5 rounded-full text-xs transition flex items-center gap-1">
                <i class="fas fa-microphone-slash"></i> Mute
              </button>
            </div>
            <div class="flex items-center gap-3">
              <i class="fas fa-volume-down text-gray-400 text-sm"></i>
              <input type="range" id="volumeSlider" min="0" max="100" value="100" class="flex-1 h-1.5 rounded-full bg-gray-700 accent-blue-500">
              <i class="fas fa-volume-up text-gray-400 text-sm"></i>
              <span id="volumePercent" class="text-xs font-mono w-10">100%</span>
            </div>
            <div class="pt-2 text-[11px] text-gray-400 flex justify-between">
              <span><i class="far fa-clock"></i> Low-latency mode</span>
              <span><i class="fas fa-shield-alt"></i> Encrypted stream</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    const socket = io();
    const tutorId = "<%= tutor._id %>";
    const studentId = "<%= user.id %>";
    const video = document.getElementById("studentVideo");
    
    let peerConnection = null;
    let currentVolume = 1.0;

    const viewerCountSpan = document.getElementById("viewerCountDisplay");
    const streamStatusText = document.getElementById("streamStatusText");
    const iceStateText = document.getElementById("iceStateText");
    const signalingStateText = document.getElementById("signalingStateText");
    const videoStatusBadge = document.getElementById("videoStatusBadge");
    const audioStatusBadge = document.getElementById("audioStatusBadge");
    const volumeSlider = document.getElementById("volumeSlider");
    const volumePercent = document.getElementById("volumePercent");
    const studentMuteBtn = document.getElementById("studentMuteBtn");

    function setVolume(value) {
      currentVolume = Math.min(1.0, Math.max(0, value));
      video.volume = currentVolume;
      volumeSlider.value = currentVolume * 100;
      volumePercent.innerText = Math.round(currentVolume * 100) + '%';
    }

    function updateConnectionInfo(field, value, isError = false) {
      if (field === 'streamStatus') streamStatusText.innerText = value;
      if (field === 'iceState') { iceStateText.innerText = value; iceStateText.style.color = isError ? '#EF4444' : '#86efac'; }
      if (field === 'signalingState') signalingStateText.innerText = value;
      if (field === 'videoStatus') { videoStatusBadge.innerText = value; videoStatusBadge.style.color = isError ? '#f87171' : '#4ade80'; }
      if (field === 'audioStatus') { audioStatusBadge.innerText = value; audioStatusBadge.style.color = isError ? '#f87171' : '#4ade80'; }
    }

    const pcConfig = {
      iceServers: [
        { urls: 'stun:stun.l.google.com:19302' },
        { urls: 'stun:stun1.l.google.com:19302' },
        { urls: 'stun:stun2.l.google.com:19302' },
        { urls: 'stun:stun3.l.google.com:19302' }
      ],
      iceCandidatePoolSize: 10
    };

    function createPeerConnection() {
      const pc = new RTCPeerConnection(pcConfig);

      pc.ontrack = (event) => {
        if (event.streams && event.streams[0]) {
          const remoteStream = event.streams[0];
          video.srcObject = remoteStream;
          video.play().catch(e => console.log(e));
          
          if (event.track.kind === 'video') {
            updateConnectionInfo('videoStatus', 'Live', false);
            event.track.onunmute = () => updateConnectionInfo('videoStatus', 'Live', false);
            event.track.onmute = () => updateConnectionInfo('videoStatus', 'Muted', true);
          }
          if (event.track.kind === 'audio') {
            updateConnectionInfo('audioStatus', 'Active', false);
            event.track.onunmute = () => updateConnectionInfo('audioStatus', 'Active', false);
            event.track.onmute = () => updateConnectionInfo('audioStatus', 'Muted', true);
          }
        }
      };

      pc.oniceconnectionstatechange = () => {
        const state = pc.iceConnectionState;
        updateConnectionInfo('iceState', state);
        if (state === 'connected') {
          updateConnectionInfo('streamStatus', 'Live');
          streamStatusText.style.color = '#10B981';
        } else if (state === 'failed') {
          updateConnectionInfo('streamStatus', 'Connection failed', true);
        }
      };

      pc.onsignalingstatechange = () => {
        updateConnectionInfo('signalingState', pc.signalingState);
      };

      pc.onicecandidate = (event) => {
        if (event.candidate) {
          socket.emit("ice-candidate", {
            candidate: event.candidate,
            tutorId: tutorId,
            role: "student",
            studentId: studentId,
            socketId: socket.id
          });
        }
      };

      return pc;
    }

    async function initializeConnection() {
      try {
        updateConnectionInfo('streamStatus', 'Joining session...');
        peerConnection = createPeerConnection();
        socket.emit("student-join", { tutorId, studentId, socketId: socket.id });
        socket.emit("student-verify", { studentId, tutorId, timestamp: Date.now() });
      } catch (err) {
        console.error(err);
        updateConnectionInfo('streamStatus', 'Failed to connect', true);
      }
    }

    socket.on("connect", () => console.log("Socket connected"));
    socket.on("verification-response", (data) => console.log("Verified", data));
    
    socket.on("tutor-offer", async ({ offer }) => {
      try {
        if (!peerConnection) peerConnection = createPeerConnection();
        await peerConnection.setRemoteDescription(new RTCSessionDescription(offer));
        const answer = await peerConnection.createAnswer();
        await peerConnection.setLocalDescription(answer);
        socket.emit("student-answer", { answer: peerConnection.localDescription, tutorId, studentId, socketId: socket.id });
      } catch (err) { console.error("Offer error", err); }
    });

    socket.on("ice-candidate", async ({ candidate, role }) => {
      if (role === "tutor" && candidate && peerConnection) {
        try {
          await peerConnection.addIceCandidate(new RTCIceCandidate(candidate));
        } catch (err) { console.error("ICE add error", err); }
      }
    });

    socket.on("viewerCountUpdate", (count) => {
      viewerCountSpan.innerText = count;
    });

    socket.on("tutorStoppedLive", () => {
      setTimeout(() => window.close(), 4000);
    });

    function toggleMute() {
      video.muted = !video.muted;
      const isMuted = video.muted;
      studentMuteBtn.innerHTML = isMuted ? '<i class="fas fa-microphone-alt"></i> Unmute' : '<i class="fas fa-microphone-slash"></i> Mute';
      updateConnectionInfo('audioStatus', isMuted ? 'Muted' : 'Active', isMuted);
      const floatingBtn = document.getElementById("floatingMuteBtn");
      if (floatingBtn) floatingBtn.innerHTML = isMuted ? '<i class="fas fa-microphone"></i>' : '<i class="fas fa-microphone-slash"></i>';
    }

    studentMuteBtn.addEventListener("click", toggleMute);
    volumeSlider.addEventListener("input", (e) => setVolume(e.target.value / 100));
    
    document.getElementById("floatingMuteBtn")?.addEventListener("click", toggleMute);
    document.getElementById("floatingVolumeUp")?.addEventListener("click", () => setVolume(Math.min(1, currentVolume + 0.1)));
    document.getElementById("floatingVolumeDown")?.addEventListener("click", () => setVolume(Math.max(0, currentVolume - 0.1)));

    window.addEventListener('load', initializeConnection);
    window.addEventListener('beforeunload', () => { if (peerConnection) peerConnection.close(); });
    
    setVolume(1.0);
  </script>
</body>
</html>
