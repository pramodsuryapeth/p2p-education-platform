<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Tutor Live Studio | Stream & Interact</title>
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* custom pulse & live badge animations */
    .live-pulse {
      animation: pulse-ring 1.5s infinite;
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
    .live-badge {
      background: #dc2626;
      color: white;
      font-weight: bold;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      letter-spacing: 0.5px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 0 5px rgba(220,38,38,0.5);
    }
    .live-badge::before {
      content: "";
      display: inline-block;
      width: 8px;
      height: 8px;
      background: white;
      border-radius: 50%;
      animation: blink-live 1s step-end infinite;
    }
    @keyframes blink-live {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
    .mirror-video {
      transform: scaleX(-1);
      -webkit-transform: scaleX(-1);
      -moz-transform: scaleX(-1);
      -ms-transform: scaleX(-1);
    }
    .quality-badge {
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(4px);
      font-size: 0.7rem;
    }
    /* custom toggle switch */
    .toggle-switch {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 24px;
    }
    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }
    .slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: #4B5563;
      transition: 0.2s;
      border-radius: 34px;
    }
    .slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: white;
      transition: 0.2s;
      border-radius: 50%;
    }
    input:checked + .slider {
      background-color: #10B981;
    }
    input:checked + .slider:before {
      transform: translateX(20px);
    }
  </style>
</head>
<body class="bg-gray-900 text-white min-h-screen">
  <!-- Header with Back Button + Live Status -->
  <header class="bg-gray-800 shadow-lg border-b border-gray-700">
    <div class="container mx-auto px-4 py-3 flex justify-between items-center flex-wrap gap-3">
      <!-- Back button -->
      <a href="/dashboard" 
         id="backButton"
         class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg flex items-center space-x-2 transition-all duration-200 shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span class="font-medium">Dashboard</span>
      </a>
      
      <!-- Right: live indicator & viewer count -->
      <div class="flex items-center space-x-4">
        <div id="liveIndicatorWrap" class="flex items-center space-x-2">
          <div id="connectionStatus" class="flex items-center space-x-2 bg-gray-700/50 px-3 py-1 rounded-full text-sm">
            <span class="w-2.5 h-2.5 bg-gray-400 rounded-full"></span>
            <span>Ready</span>
          </div>
        </div>
        <div id="viewerCount" class="bg-gray-700 px-3 py-1 rounded-full text-sm font-mono shadow-inner">
          👥 Viewers: <span id="viewerCountNumber">0</span>
        </div>
      </div>
    </div>
  </header>

  <div class="container mx-auto p-4 md:p-6">
    <!-- Page Title & tutor name -->
    <div class="mb-5 flex flex-wrap justify-between items-center">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">🎙️ Live Studio</h1>
        <p class="text-gray-400 text-sm mt-1"><%= tutor.name %> · educator dashboard</p>
      </div>
      <div id="streamLiveBadge" class="hidden">
        <div class="live-badge">LIVE</div>
      </div>
    </div>

    <!-- Video + Controls Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Video Area -->
      <div class="lg:col-span-2 bg-black rounded-xl overflow-hidden relative shadow-2xl border border-gray-700">
        <video 
          id="tutorVideo" 
          autoplay 
          muted 
          playsinline 
          class="w-full h-64 lg:h-96 object-cover mirror-video"
        ></video>
        
        <!-- Floating quality indicator (new) -->
        <div class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-sm text-white text-xs px-2 py-1 rounded-full flex items-center gap-1">
          <span class="w-2 h-2 bg-green-400 rounded-full"></span>
          <span id="videoQualityHint">HD ready</span>
        </div>
        
        <!-- Small camera label (new) -->
        <div class="absolute top-3 left-3 bg-black/50 backdrop-blur-sm text-white text-[11px] px-2 py-1 rounded-full">
          📹 Tutor feed
        </div>
      </div>

      <!-- Controls Panel (enhanced) -->
      <div class="space-y-4">
        <div class="bg-gray-800/90 backdrop-blur-sm rounded-xl p-5 border border-gray-700 shadow-lg">
          <h3 class="font-semibold text-lg mb-3 flex items-center gap-2">🎛️ Stream Controls</h3>
          
          <div class="space-y-3">
            <button id="startLiveBtn" class="w-full bg-green-600 hover:bg-green-500 transition-all transform hover:scale-[1.01] text-white font-medium py-2.5 px-4 rounded-xl shadow-md">
              🟢 Start Live Stream
            </button>
            
            <button id="stopLiveBtn" class="w-full bg-red-600 hover:bg-red-700 transition-all text-white font-medium py-2.5 px-4 rounded-xl shadow-md hidden">
              🔴 Stop Live Broadcast
            </button>

            <div class="grid grid-cols-2 gap-3">
              <button id="shareScreenBtn" class="bg-blue-600 hover:bg-blue-500 transition text-white py-2 px-3 rounded-xl flex items-center justify-center gap-1 text-sm">
                📺 Share Screen
              </button>
              <button id="switchCameraBtn" class="bg-purple-600 hover:bg-purple-500 transition text-white py-2 px-3 rounded-xl flex items-center justify-center gap-1 text-sm">
                🔄 Switch Cam
              </button>
            </div>

            <!-- NEW: Mirror toggle (self-view only) -->
            <div class="flex items-center justify-between bg-gray-700/50 p-3 rounded-xl mt-2">
              <div class="flex items-center gap-2 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                <span>Mirror View (self)</span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="mirrorToggleCheckbox" checked>
                <span class="slider"></span>
              </label>
            </div>
          </div>
        </div>

        <!-- Stream Info Card (enhanced) -->
        <div class="bg-gray-800 rounded-xl p-5 border border-gray-700">
          <h3 class="font-semibold mb-3 flex items-center gap-2">📡 Stream Health</h3>
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div class="bg-gray-900/60 p-2 rounded-lg">
              <p class="text-gray-400 text-xs">Status</p>
              <p><span id="streamStatus" class="text-red-500 font-bold">Offline</span></p>
            </div>
            <div class="bg-gray-900/60 p-2 rounded-lg">
              <p class="text-gray-400 text-xs">Students</p>
              <p><span id="connectedStudents" class="text-cyan-400 font-bold">0</span></p>
            </div>
            <div class="bg-gray-900/60 p-2 rounded-lg col-span-2">
              <p class="text-gray-400 text-xs">Stream duration</p>
              <p class="font-mono text-lg font-bold" id="streamDuration">00:00:00</p>
            </div>
          </div>
        </div>

        <!-- Audio Controls + Meter (compact) -->
        <div class="bg-gray-800 rounded-xl p-5 border border-gray-700">
          <h3 class="font-semibold mb-3">🎧 Audio Manager</h3>
          <div class="flex flex-wrap gap-3">
            <button id="muteAudioBtn" class="bg-blue-600 hover:bg-blue-500 text-white py-2 px-4 rounded-xl transition flex-1 text-sm">
              🎤 Mute Audio
            </button>
            <button id="testAudioBtn" class="bg-emerald-600 hover:bg-emerald-500 text-white py-2 px-4 rounded-xl transition flex-1 text-sm">
              🔊 Test
            </button>
          </div>
          <div class="mt-4 space-y-1">
            <div class="flex justify-between text-xs text-gray-400"><span>Input level</span><span id="audioLevelText">0%</span></div>
            <div class="w-full h-2 bg-gray-700 rounded-full overflow-hidden">
              <div id="audioLevelBar" class="h-full bg-gradient-to-r from-green-400 to-green-500 rounded-full transition-all duration-75" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // ------------------- CLEAN LOGGING (console only, no UI panel) -------------------
    function silentLog(message) {
      console.log(`[Tutor Studio] ${message}`);
    }

    const socket = io();
    const tutorId = "<%= tutor._id %>";
    const video = document.getElementById("tutorVideo");
    const backButton = document.getElementById("backButton");
    
    // DOM elements
    const startLiveBtn = document.getElementById("startLiveBtn");
    const stopLiveBtn = document.getElementById("stopLiveBtn");
    const shareScreenBtn = document.getElementById("shareScreenBtn");
    const switchCameraBtn = document.getElementById("switchCameraBtn");
    const muteAudioBtn = document.getElementById("muteAudioBtn");
    const testAudioBtn = document.getElementById("testAudioBtn");
    const mirrorToggle = document.getElementById("mirrorToggleCheckbox");
    const streamStatusSpan = document.getElementById("streamStatus");
    const connectedStudentsSpan = document.getElementById("connectedStudents");
    const streamDurationSpan = document.getElementById("streamDuration");
    const viewerCountSpan = document.getElementById("viewerCountNumber");
    const liveBadgeWrap = document.getElementById("streamLiveBadge");
    const audioLevelBar = document.getElementById("audioLevelBar");
    const audioLevelText = document.getElementById("audioLevelText");
    
    let localStream = null;
    let screenStream = null;
    let peerConnections = {};
    let streamStartTime = null;
    let streamTimer = null;
    let currentCamera = 'user';
    let audioContext = null;
    let analyser = null;
    let isLive = false;
    let currentAudioMuted = false;

    // ----- helper functions -----
    function updateConnectionStatus(status, colorCode) {
      const statusContainer = document.getElementById("connectionStatus");
      if (statusContainer) {
        statusContainer.innerHTML = `<span class="w-2.5 h-2.5 rounded-full" style="background-color: ${colorCode}"></span><span>${status}</span>`;
      }
    }

    function updateViewerCount(count) {
      viewerCountSpan.textContent = count;
      connectedStudentsSpan.textContent = count;
    }

    function startStreamTimer() {
      streamStartTime = new Date();
      if (streamTimer) clearInterval(streamTimer);
      streamTimer = setInterval(() => {
        const now = new Date();
        const diff = Math.floor((now - streamStartTime) / 1000);
        const hrs = Math.floor(diff / 3600);
        const mins = Math.floor((diff % 3600) / 60);
        const secs = diff % 60;
        streamDurationSpan.textContent = `${hrs.toString().padStart(2,'0')}:${mins.toString().padStart(2,'0')}:${secs.toString().padStart(2,'0')}`;
      }, 1000);
    }

    function stopStreamTimer() {
      if (streamTimer) clearInterval(streamTimer);
      streamTimer = null;
      streamDurationSpan.textContent = "00:00:00";
    }

    // Stop everything gracefully
    async function stopLiveStream(keepLocal = false) {
      if (!isLive && !localStream) return true;
      silentLog("Stopping live stream...");
      
      // Notify server
      socket.emit("tutor-stop", { tutorId });
      
      // Close all peer connections
      Object.keys(peerConnections).forEach(studentId => {
        if (peerConnections[studentId]) {
          peerConnections[studentId].close();
          delete peerConnections[studentId];
        }
      });
      peerConnections = {};
      
      if (localStream && !keepLocal) {
        localStream.getTracks().forEach(track => track.stop());
        localStream = null;
      }
      if (screenStream) {
        screenStream.getTracks().forEach(track => track.stop());
        screenStream = null;
      }
      
      if (!keepLocal) video.srcObject = null;
      
      // UI updates
      startLiveBtn.classList.remove("hidden");
      stopLiveBtn.classList.add("hidden");
      streamStatusSpan.textContent = "Offline";
      streamStatusSpan.className = "text-red-500 font-bold";
      updateConnectionStatus('Offline', '#EF4444');
      stopStreamTimer();
      updateViewerCount(0);
      isLive = false;
      liveBadgeWrap.classList.add("hidden");
      
      // reset audio meter
      if (audioLevelBar) audioLevelBar.style.width = "0%";
      if (audioLevelText) audioLevelText.textContent = "0%";
      
      silentLog("Live stream fully stopped");
      return true;
    }

    // WebRTC config
    const pcConfig = {
      iceServers: [
        { urls: 'stun:stun.l.google.com:19302' },
        { urls: 'stun:stun1.l.google.com:19302' },
        { urls: 'stun:stun2.l.google.com:19302' },
        { urls: 'stun:stun3.l.google.com:19302' }
      ],
      iceCandidatePoolSize: 10
    };

    function createPeerConnection(studentId) {
      const pc = new RTCPeerConnection(pcConfig);
      if (localStream) {
        localStream.getTracks().forEach(track => {
          pc.addTrack(track, localStream);
        });
      }
      
      pc.onicecandidate = (event) => {
        if (event.candidate) {
          socket.emit("ice-candidate", { candidate: event.candidate, studentId, role: "tutor", tutorId });
        }
      };
      pc.onconnectionstatechange = () => {
        silentLog(`PeerConn ${studentId} state: ${pc.connectionState}`);
      };
      return pc;
    }

    // Audio monitoring (visualizer)
    function startAudioMonitoring(stream) {
      if (!stream) return;
      try {
        if (audioContext && audioContext.state !== 'closed') audioContext.close();
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        analyser = audioContext.createAnalyser();
        const source = audioContext.createMediaStreamSource(stream);
        source.connect(analyser);
        analyser.fftSize = 256;
        const bufferLength = analyser.frequencyBinCount;
        const dataArray = new Uint8Array(bufferLength);
        
        function updateMeter() {
          if (!analyser || !isLive) return;
          analyser.getByteFrequencyData(dataArray);
          let sum = 0;
          for (let i = 0; i < bufferLength; i++) sum += dataArray[i];
          let avg = sum / (bufferLength || 1);
          let percent = Math.min(100, (avg / 200) * 100);
          if (audioLevelBar) audioLevelBar.style.width = percent + "%";
          if (audioLevelText) audioLevelText.textContent = Math.floor(percent) + "%";
          requestAnimationFrame(updateMeter);
        }
        if (audioContext.state === 'suspended') audioContext.resume();
        updateMeter();
        silentLog("Audio visualizer active");
      } catch (err) {
        silentLog("Audio meter error: " + err.message);
      }
    }

    // Obtain camera + mic
    async function getCameraAndMic() {
      const constraints = {
        video: { facingMode: currentCamera, width: { ideal: 1280 }, height: { ideal: 720 } },
        audio: true
      };
      const stream = await navigator.mediaDevices.getUserMedia(constraints);
      return stream;
    }

    // ---- EVENT HANDLERS ----
    startLiveBtn.addEventListener("click", async () => {
      if (isLive) return;
      try {
        silentLog("Initiating live stream...");
        updateConnectionStatus('Connecting', '#F59E0B');
        localStream = await getCameraAndMic();
        video.srcObject = localStream;
        // mirror default on
        if (mirrorToggle.checked) video.classList.add("mirror-video");
        else video.classList.remove("mirror-video");
        
        startAudioMonitoring(localStream);
        socket.emit("tutor-start", { tutorId });
        
        startLiveBtn.classList.add("hidden");
        stopLiveBtn.classList.remove("hidden");
        streamStatusSpan.textContent = "LIVE";
        streamStatusSpan.className = "text-green-500 font-bold animate-pulse";
        updateConnectionStatus('Broadcasting', '#10B981');
        startStreamTimer();
        isLive = true;
        liveBadgeWrap.classList.remove("hidden");
        silentLog("✅ Stream is LIVE");
      } catch (err) {
        silentLog("Start error: " + err.message);
        alert("Could not access camera/mic: " + err.message);
        updateConnectionStatus('Error', '#EF4444');
      }
    });

    stopLiveBtn.addEventListener("click", async () => {
      await stopLiveStream(false);
    });

    backButton.addEventListener("click", async (e) => {
      e.preventDefault();
      if (isLive) {
        const confirmLeave = confirm("You are LIVE! Stopping will disconnect all students. Proceed?");
        if (!confirmLeave) return;
        await stopLiveStream(false);
        setTimeout(() => { window.location.href = "/dashboard"; }, 300);
      } else {
        window.location.href = "/dashboard";
      }
    });

    // Share Screen
    shareScreenBtn.addEventListener("click", async () => {
      if (!localStream) { alert("Please start live stream first"); return; }
      try {
        screenStream = await navigator.mediaDevices.getDisplayMedia({ video: { cursor: 'always' }, audio: true });
        const videoTrack = screenStream.getVideoTracks()[0];
        Object.values(peerConnections).forEach(pc => {
          const sender = pc.getSenders().find(s => s.track?.kind === 'video');
          if (sender) sender.replaceTrack(videoTrack);
        });
        videoTrack.onended = () => {
          if (localStream) {
            const camTrack = localStream.getVideoTracks()[0];
            Object.values(peerConnections).forEach(pc => {
              const sender = pc.getSenders().find(s => s.track?.kind === 'video');
              if (sender && camTrack) sender.replaceTrack(camTrack);
            });
          }
          screenStream = null;
        };
        silentLog("Screen sharing active");
      } catch (err) { silentLog("Screen share error: " + err.message); }
    });

    // Switch camera
    switchCameraBtn.addEventListener("click", async () => {
      if (!localStream) { alert("Start stream first"); return; }
      try {
        currentCamera = currentCamera === 'user' ? 'environment' : 'user';
        const newStream = await getCameraAndMic();
        const oldVideoTrack = localStream.getVideoTracks()[0];
        const newVideoTrack = newStream.getVideoTracks()[0];
        const oldAudioTrack = localStream.getAudioTracks()[0];
        const newAudioTrack = newStream.getAudioTracks()[0];
        
        // replace tracks for all peers
        Object.values(peerConnections).forEach(pc => {
          const videoSender = pc.getSenders().find(s => s.track?.kind === 'video');
          if (videoSender && newVideoTrack) videoSender.replaceTrack(newVideoTrack);
          const audioSender = pc.getSenders().find(s => s.track?.kind === 'audio');
          if (audioSender && newAudioTrack) audioSender.replaceTrack(newAudioTrack);
        });
        // update local video
        video.srcObject = newStream;
        if (mirrorToggle.checked) video.classList.add("mirror-video");
        else video.classList.remove("mirror-video");
        
        oldVideoTrack?.stop();
        if (oldAudioTrack && oldAudioTrack !== newAudioTrack) oldAudioTrack.stop();
        localStream = newStream;
        startAudioMonitoring(localStream);
        silentLog(`Camera switched to ${currentCamera}`);
      } catch (err) { silentLog("Switch camera fail: " + err.message); }
    });

    // Mirror toggle (self mirror effect, students see original)
    mirrorToggle.addEventListener("change", (e) => {
      if (video) {
        if (e.target.checked) video.classList.add("mirror-video");
        else video.classList.remove("mirror-video");
        silentLog(`Mirror view ${e.target.checked ? "ON" : "OFF"} (students unaffected)`);
      }
    });

    // Mute audio toggle
    muteAudioBtn.addEventListener("click", () => {
      if (localStream) {
        const audioTrack = localStream.getAudioTracks()[0];
        if (audioTrack) {
          audioTrack.enabled = !audioTrack.enabled;
          currentAudioMuted = !audioTrack.enabled;
          muteAudioBtn.textContent = currentAudioMuted ? "🎤 Unmute Audio" : "🎤 Mute Audio";
          silentLog(`Microphone ${currentAudioMuted ? 'muted' : 'unmuted'}`);
        }
      }
    });

    testAudioBtn.addEventListener("click", async () => {
      try {
        const testStream = await navigator.mediaDevices.getUserMedia({ audio: true });
        const audioEl = new Audio();
        audioEl.srcObject = testStream;
        audioEl.play();
        setTimeout(() => testStream.getTracks().forEach(t => t.stop()), 2500);
        silentLog("Audio test played");
      } catch (err) { silentLog("Test audio failed: " + err.message); }
    });

    // ---- SOCKET WEBRTC SIGNALING ----
    socket.on("connect", () => {
      silentLog("Socket connected");
      updateConnectionStatus('Connected', '#10B981');
    });
    socket.on("disconnect", () => updateConnectionStatus('Disconnected', '#EF4444'));

    socket.on("student-join", async ({ studentId, socketId }) => {
      silentLog(`Student ${studentId} joining`);
      if (!isLive || !localStream) {
        silentLog("Stream not live, ignoring student join");
        return;
      }
      try {
        if (peerConnections[studentId]) peerConnections[studentId].close();
        const pc = createPeerConnection(studentId);
        peerConnections[studentId] = pc;
        const offer = await pc.createOffer({ offerToReceiveAudio: true, offerToReceiveVideo: true });
        await pc.setLocalDescription(offer);
        socket.emit("tutor-offer", { offer: pc.localDescription, studentId, tutorId });
      } catch (err) { silentLog(`Offer error: ${err.message}`); }
    });

    socket.on("student-answer", async ({ studentId, answer }) => {
      const pc = peerConnections[studentId];
      if (pc) {
        try {
          await pc.setRemoteDescription(new RTCSessionDescription(answer));
          silentLog(`Remote description set for ${studentId}`);
        } catch (err) { silentLog(`Answer error: ${err.message}`); }
      }
    });

    socket.on("ice-candidate", async ({ candidate, studentId }) => {
      const pc = peerConnections[studentId];
      if (pc && candidate) {
        try {
          await pc.addIceCandidate(new RTCIceCandidate(candidate));
        } catch (err) { silentLog(`ICE add fail: ${err.message}`); }
      }
    });

    socket.on("viewerCountUpdate", (count) => {
      updateViewerCount(count);
    });

    // cleanup before unload
    window.addEventListener('beforeunload', (e) => {
      if (isLive) {
        stopLiveStream(false);
      }
    });
    
    silentLog("Tutor studio ready — mirror toggle added, logs hidden, UI cleaned");
    updateConnectionStatus('Ready', '#3B82F6');
  </script>
</body>
</html>
