<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Tutor Messages - Student Conversations</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="bg-gray-50 min-h-screen">

  <!-- Header -->
  <div class="bg-white shadow-sm border-b">
    <div class="max-w-4xl mx-auto px-4">
      <div class="flex justify-between items-center py-4">
        <div>
          <h1 class="text-xl font-bold text-gray-800">Student Messages</h1>
          <p class="text-sm text-gray-500">Chat with your students</p>
        </div>
        <div class="flex items-center space-x-3">
          <a href="/dashboard" class="text-sm bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600">
            <i class="fas fa-home mr-1"></i> Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-4xl mx-auto px-4 py-6">
    <div class="bg-white rounded-xl shadow-md border overflow-hidden">
      
      <!-- Stats and Refresh Button -->
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 px-6 py-4 border-b">
        <div class="flex justify-between items-center">
          <div>
            <p class="text-sm text-gray-600">
              <% 
                const totalMessages = messages ? messages.length : 0;
                const unreadCount = messages ? messages.filter(m => m.unseenCount > 0).length : 0;
              %>

            </p>
          </div>
          <div class="flex space-x-2">
            <button onclick="location.reload()" class="text-xs bg-blue-100 text-blue-700 px-3 py-1 rounded-lg hover:bg-blue-200">
              <i class="fas fa-sync-alt mr-1"></i> Refresh
            </button>
          </div>
        </div>
      </div>

      <!-- Message List -->
      <div id="messageList" class="divide-y">
        <% 
          const getInitials = (name) => {
            if (!name) return 'S';
            return name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
          };

          if (messages && messages.length > 0) { 
            messages.forEach((msg, index) => { 
              const imageUrl = msg.imageUrl;
              const initials = getInitials(msg.username);
              const hasUnseen = msg.unseenCount > 0;
        %>
          <a href="/messages/<%= msg.senderId %>" 
             class="block transition-all duration-200 hover:bg-gray-50 <%= hasUnseen ? 'bg-blue-50 border-l-4 border-blue-500' : '' %>"
             data-sender-id="<%= msg.senderId %>">
            
            <div class="px-6 py-4 flex items-center space-x-4">
              
              <!-- Avatar Container -->
              <div class="relative">
                <% if (imageUrl) { %>
                  <img
                    src="<%= imageUrl %>"
                    alt="<%= msg.username %>"
                    class="w-10 h-10 rounded-full object-cover border-2 border-gray-200"
                    onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                    loading="lazy"
                  >
                  <div class="hidden w-10 h-10 rounded-full flex items-center justify-center bg-gradient-to-br from-purple-500 to-pink-500 text-white font-bold text-sm uppercase">
                    <%= initials %>
                  </div>
                <% } else { %>
                  <div class="w-10 h-10 rounded-full flex items-center justify-center bg-gradient-to-br from-purple-500 to-pink-500 text-white font-bold text-sm uppercase">
                    <%= initials %>
                  </div>
                <% } %>
                
                <% if (hasUnseen) { %>
                  <div class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full border-2 border-white flex items-center justify-center">
                    <span class="text-xs font-bold text-white">
                      <%= msg.unseenCount > 9 ? '9+' : msg.unseenCount %>
                    </span>
                  </div>
                <% } %>
              </div>

              <!-- Message Content -->
              <div class="flex-1 min-w-0">
                <div class="flex justify-between items-center mb-1">
                  <div class="flex items-center space-x-2">
                    <h3 class="font-semibold text-gray-900 truncate">
                      <%= msg.username || 'Unknown Student' %>
                    </h3>
                    <% if (hasUnseen) { %>
                      <span class="text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full">
                        New
                      </span>
                    <% } %>
                  </div>
                  <% if (msg.timestamp) { %>
                    <span class="text-xs text-gray-500 whitespace-nowrap">
                      <%= new Date(msg.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                  <% } %>
                </div>
                
                <div class="flex justify-between items-center">
                  <p class="text-sm text-gray-600 truncate flex-1 pr-2">
                    <% if (msg.text) { %>
                      <% if (msg.text.length > 80) { %>
                        <%= msg.text.substring(0, 80) %>...
                      <% } else { %>
                        <%= msg.text %>
                      <% } %>
                    <% } else { %>
                      <span class="text-gray-400 italic">No message content</span>
                    <% } %>
                  </p>
                  
                  <div class="flex items-center space-x-2">
                    <% if (hasUnseen) { %>
                      <span class="text-xs font-medium text-red-600">
                        <%= msg.unseenCount %> new
                      </span>
                    <% } %>
                    <i class="fas fa-chevron-right text-gray-400 text-sm"></i>
                  </div>
                </div>
              </div>
            </div>
          </a>
        <% }); %>
        <% } else { %>
          <!-- Empty State -->
          <div class="text-center py-12">
            <div class="text-gray-300 mb-4">
              <i class="fas fa-comments text-5xl"></i>
            </div>
            <h3 class="text-lg font-semibold text-gray-600 mb-2">No messages yet</h3>
            <p class="text-gray-500 max-w-md mx-auto mb-6">
              When students send you messages, they'll appear here. 
              You can start conversations from student profiles.
            </p>
            <a href="/dashboard" class="inline-flex items-center text-blue-600 hover:text-blue-800">
              <i class="fas fa-arrow-left mr-2"></i>
              Back to Dashboard
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    const socket = io();
    const currentUserId = '<%= (user && user.id) ? user.id : "" %>';
    
    document.addEventListener('DOMContentLoaded', function() {
      if (currentUserId) {
        socket.emit('joinMessageRoom', currentUserId);
      }
    });

    socket.on('newMessageNotification', function(data) {
      showNotification(`New message from ${data.senderName || 'a student'}`);
      updateConversation(data);
    });

    socket.on('unseenCountUpdate', function(data) {
      updateUnseenBadge(data.senderId, data.unseenCount);
    });

    function showNotification(message) {
      const notification = document.createElement('div');
      notification.className = 'fixed top-4 right-4 bg-blue-500 text-white px-4 py-3 rounded-lg shadow-lg z-50';
      notification.innerHTML = `
        <div class="flex items-center">
          <i class="fas fa-comment-dots mr-2"></i>
          <span>${message}</span>
        </div>
      `;
      
      document.body.appendChild(notification);
      
      setTimeout(() => {
        notification.remove();
      }, 3000);
    }

    function updateConversation(data) {
      const conversation = document.querySelector(`[data-sender-id="${data.senderId}"]`);
      
      if (conversation) {
        const textElement = conversation.querySelector('.text-sm.text-gray-600');
        const timeElement = conversation.querySelector('.text-xs.text-gray-500');
        
        if (textElement) {
          textElement.textContent = data.message.length > 80 ? 
            data.message.substring(0, 80) + '...' : 
            data.message;
        }
        
        if (timeElement) {
          timeElement.textContent = new Date().toLocaleTimeString([], { 
            hour: '2-digit', 
            minute: '2-digit' 
          });
        }
        
        conversation.classList.add('bg-blue-50', 'border-l-4', 'border-blue-500');
      }
    }

    function updateUnseenBadge(senderId, count) {
      const conversation = document.querySelector(`[data-sender-id="${senderId}"]`);
      if (conversation) {
        const badge = conversation.querySelector('.bg-red-500 span');
        if (badge) {
          badge.textContent = count > 9 ? '9+' : count;
        }
      }
    }
  </script>
</body>
</html>